# secrets.toml.example
# Plantilla de variables de entorno / secretos para despliegue en Streamlit Community Cloud
# NOTA: Este proyecto no requiere tokens ni claves privadas para la consulta local o en la nube.
# Si se añaden claves de API externas en el futuro, defínalas aquí y cree .streamlit/secrets.toml localmente.

# EJEMPLO:
# API_KEY_OPCIONAL = "su_clave_aqui"
