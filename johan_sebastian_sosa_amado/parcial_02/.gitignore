# Entorno virtual y caché de Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Credenciales: nunca se suben. config.toml sí se sube.
.streamlit/secrets.toml

# Salidas intermedias que scraper.py vuelve a crear en cada corrida
resultados/

