# Copie este archivo como .streamlit/secrets.toml (está en .gitignore) o configure estos valores en la plataforma de despliegue
# (Streamlit Community Cloud: App settings > Secrets). Son OPCIONALES: el scraper funciona con los valores por defecto.
SCRAPER_CONTACTO = "correo-o-usuario-de-contacto"      # va en el agente de usuario para que los sitios identifiquen al responsable
# MAX_PETICIONES_COMERCIO = "1500"                     # tope de peticiones por comercio y ejecución
